{
  "name": "po-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Gmail Inbox sender collector",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "lint": "eslint server client/src vite.config.js",
    "test": "node --test",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.0.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.1",
    "vite": "^6.3.5"
  }
}
